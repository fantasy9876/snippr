<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Deliberately NOT a Windows target: everything this gate checks is
         numbers and tables, so it runs on the CI runner AND on the macOS
         machine the port is written on. net8.0 is what CI has; net10.0 is what
         the dev machine has. Pixels belong in the Windows-only raster gate. -->
    <!-- CI pins the .NET 8 SDK, which cannot target net10.0 at all: a second
         TFM listed unconditionally fails RESTORE there, `-f net8.0` or not.
         So the extra local framework appears only on an SDK new enough to
         build it, which is the dev machine. -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0'))">net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>Snippr.Win.ParityGate</AssemblyName>
    <RootNamespace>Snippr.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ToolCatalog.cs" Link="ToolCatalog.cs" />
    <Compile Include="..\Backdrop.cs" Link="Backdrop.cs" />
    <!-- The timeline RULES are platform-free on purpose; the editor's wiring
         to them is checked in the raster gate, where GDI+ lives. -->
    <Compile Include="..\Timeline.cs" Link="Timeline.cs" />
    <Compile Include="..\CropGeometry.cs" Link="CropGeometry.cs" />
    <!-- The overlay toolbar's geometry, from the UI lane. Pure arithmetic, so
         it belongs on this side of the gate rather than the raster one. -->
    <Compile Include="..\Ui\OverlayToolbarLayout.cs" Link="OverlayToolbarLayout.cs" />
    <Compile Include="..\Ui\ThemeMetrics.cs" Link="ThemeMetrics.cs" />
    <Compile Include="..\Ui\EditorChromeMetrics.cs" Link="EditorChromeMetrics.cs" />
    <Compile Include="..\AreaReviewHitTest.cs" Link="AreaReviewHitTest.cs" />
    <Compile Include="..\AreaReviewCrop.cs" Link="AreaReviewCrop.cs" />
    <Compile Include="..\EditorActionRouter.cs" Link="EditorActionRouter.cs" />
  </ItemGroup>

</Project>
