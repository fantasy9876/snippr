<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Snippr</RootNamespace>
    <AssemblyName>Snippr</AssemblyName>
    <ApplicationIcon>snippr.ico</ApplicationIcon>
    <Version>1.2.13</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Snippr.Win.StitcherGate/**" />
    <None Include="Snippr.Win.StitcherGate/**" />
    <!-- Same reason as the stitcher gate: the gate projects live under
         windows/ and their build output would otherwise be swept into the app
         by the default glob. -->
    <Compile Remove="Snippr.Win.ParityGate/**" />
    <None Include="Snippr.Win.ParityGate/**" />
    <Compile Remove="Snippr.Win.RasterGate/**" />
    <None Include="Snippr.Win.RasterGate/**" />
  </ItemGroup>

</Project>
